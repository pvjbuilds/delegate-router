# delegate-router settings. install.sh writes the real file to
# ${XDG_CONFIG_HOME:-~/.config}/delegate-router/config.env. Environment variables of the same name win.

# Which hosts the skill is linked into. install.sh asks; these remember the answers.
INSTALL_CLAUDE_CODE=1
INSTALL_CODEX=1

# Check for new models in the background, at most every 12 h, when the skill runs. 1 = on.
BACKGROUND=1

# When a new model is announced: update that CLI through the channel it was installed with
# (Homebrew cask, npm, or the CLI's own updater) and prove the model answers with a one-word,
# read-only probe with your CLI config and integrations off. 0 = only report it.
AUTO_UPDATE_CLI=0

# Optional Jev (TypeSafe) calls: judge release notes, and scout files before writing a spec.
# Needs uv and TYPESAFE_API_KEY (environment, or the macOS keychain). Sends text to TypeSafe.
JEV=0

# Paths to the CLIs, for the watcher only (e.g. when a hook runs without your shell's PATH).
# Delegation itself calls codex, claude and agy by name, so they must be on PATH.
# CODEX_BIN=/path/to/codex
# CLAUDE_BIN=/path/to/claude
# AGY_BIN=/path/to/agy
